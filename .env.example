# SG Wardrobe backend (Cloud Run). Copy to .env, fill in, then upload as the repo's DOTENV secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-emily-sg-wardrobe < .env
# Cloud Run URL (known in advance): https://ail-ay2627-s1-emily-sg-wardrobe-464725632804.asia-southeast3.run.app
# Keep comments on their own lines (no inline comments after values).

# Frontend origin(s) allowed by CORS, comma-separated (the Vercel site).
CORS_ORIGINS=https://ail-ay2627-s1-emily-sg-wardrobe.vercel.app

# OpenRouter: all four AI tasks (outfits, style profile, size check, wardrobe review).
# Without a key the API answers {"ai": false} and the site switches its AI features off.
API_KEY=your-openrouter-key
# Any apiyi model that returns JSON well, e.g. gemini-3.5-flash-lite or anthropic/claude-sonnet-4.5.
MODEL_NAME=gemini-3.5-flash-lite

# Shared AI Lodge rate limiter (Upstash Redis). Unset = no limiting (local dev).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Fallback limits when the central sheet has no row: AI requests per IP per window (all four tasks share one bucket).
RATE_LIMIT_STYLE_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# Optional: per-instance flood guard on /api/product (shop-page reads, no AI). Defaults 20 per 600 s.
# PRODUCT_FLOOD_MAX=20
# PRODUCT_FLOOD_WINDOW_SECONDS=600

# Optional: point at an apiyi-compatible endpoint (local stubs only). Default https://api.apiyi.com/v1
# API_BASE_URL=
